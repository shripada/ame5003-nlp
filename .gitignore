# This repo is GENERATED by tools/publish.py in the private course repo.
# Nothing here is hand-edited. This file exists only to keep OS and editor
# droppings out of a repository students can see.
#
# WARNING: never add a broad dotfile rule (".*" or similar) here. .nojekyll
# is a dotfile and it MUST stay tracked — without it GitHub Pages runs Jekyll,
# which silently drops any path beginning with an underscore.

# macOS / Windows
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Students may open the notebooks locally before forking to Colab
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Belt and braces: keep the Pages build directive tracked no matter what.
!.nojekyll
